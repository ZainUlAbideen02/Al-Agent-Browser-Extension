{
  "manifest_version": 3,
  "name": "Antigravity Visual Browser Agent",
  "version": "2.0.0",
  "description": "100% Standalone, Browser-Native AI Computer-Use Agent and Form Auto-Filler.",
  "permissions": [
    "scripting",
    "storage",
    "sidePanel",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "https://api.groq.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Visual Agent Side Panel"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
